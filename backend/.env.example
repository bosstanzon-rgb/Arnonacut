# Copy to `backend/.env` for local configuration (this file is safe to commit).

# SQLite (default)
ARNONACUT_DATABASE_URL=sqlite:///./arnonacut.db

# PostgreSQL example (uncomment when you migrate)
# ARNONACUT_DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/arnonacut

ARNONACUT_DEMO_PAYMENT_SECRET=change-me-demo-secret

# Local development only: allows completing checkout without `X-Demo-Secret`.
# NEVER enable this in production.
ARNONACUT_ALLOW_INSECURE_DEMO_CHECKOUT=true

# Simulated checkout (no card). Disable in production; wire Stripe / PayPlus / CreditGuard instead.
ARNONACUT_ENABLE_PLACEHOLDER_PAYMENTS=true

ARNONACUT_KIT_PRICE_ILS=99

# Comma-separated browser origins for CORS. Do not use "*" in production behind credentials.
ARNONACUT_CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Sliding-window requests per IP per minute for paths under /api (health exempt). In-memory only.
ARNONACUT_RATE_LIMIT_PUBLIC_API_PER_MINUTE=120

# Optional: enables GET/PUT/PATCH /api/admin/rules/... with header X-Admin-Key. Leave empty to disable (404).
# ARNONACUT_ADMIN_API_KEY=
